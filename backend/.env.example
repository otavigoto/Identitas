# Copie para .env e preencha. O .env nunca vai para o Git.

# String de conexão do MongoDB (ex.: mongodb+srv://usuario:senha@cluster/identitasdb)
MONGODB=

# Segredo que assina os tokens JWT. Obrigatório (mínimo 16 caracteres); sem ele o
# servidor não sobe. Gere um com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Opcional (padrão 3000)
# PORT=3000
